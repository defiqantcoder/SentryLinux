{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentryLinux",
  "version": "2.4.1",
  "identifier": "org.sentrylinux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SentryLinux — Ubuntu 24.04 LTS Endpoint Security & Telemetry Console",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://generativelanguage.googleapis.com http://127.0.0.1:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/icon.svg"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "polkitd",
          "libsecret-1-0"
        ]
      }
    }
  }
}
